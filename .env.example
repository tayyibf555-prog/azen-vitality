NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# People & Logins (owner-only user provisioning). Set to "true" ONLY when custom
# SMTP is configured on the Supabase project, in which case Supabase emails each
# invite itself and no link is ever shown to the practice owner. Left unset (the
# default), the platform mints a one-time /set-password link and hands it to the
# owner to pass on securely — because Supabase's BUILT-IN mailer is rate limited to
# a handful of messages an hour and delivers only to the project's own team, so a
# practice inviting fifty staff through it would see most invites never arrive.
# Either way no password is ever created, set or seen by the platform.
# Also required for the email path: add "<PUBLIC_BASE_URL>/set-password" to the
# Supabase project's Auth -> URL Configuration -> Redirect URLs allow-list.
SUPABASE_SMTP_CONFIGURED=
DENTALLY_API_KEY=
DENTALLY_BASE_URL=https://api.sandbox.dentally.co
# Gated real-write path for the booking agent (book/reschedule/cancel into Dentally).
# OFF by default: the agent writes to the mock until BOTH of these are set AND
# DENTALLY_WRITE_ENABLED="true". Point DENTALLY_WRITE_BASE_URL at the Dentally SANDBOX
# and validate an end-to-end booking there before ever enabling against a live book.
DENTALLY_WRITE_ENABLED=
DENTALLY_WRITE_API_KEY=
DENTALLY_WRITE_BASE_URL=https://api.sandbox.dentally.co
ANTHROPIC_API_KEY=
COORDINATOR_AUTO_SEND_THRESHOLD=250
REACTIVATION_LAPSE_MONTHS=18
REACTIVATION_RECALL_GRACE_DAYS=60
REACTIVATION_STALE_DAYS=120
REACTIVATION_BASELINE_VALUE=80
REACTIVATION_AUTO_SEND_THRESHOLD=250
# Messaging (Twilio SMS + WhatsApp, Resend email)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
RESEND_API_KEY=
RESEND_FROM=
RESEND_SUBJECT=A note from Vitality Dental
MESSAGING_DRY_RUN=true
CRON_SECRET=
PUBLIC_BASE_URL=http://localhost:3000

# Practice Brain (knowledge hub) — HMAC secret for the unlock session cookie
PRACTICE_BRAIN_SESSION_SECRET=

# Optional: enables semantic (embeddings) retrieval. Without it, the co-pilot uses keyword retrieval.
VOYAGE_API_KEY=

# Staff handover alerts: when the SMS agent hands a conversation to a human
# (escalation, safety filter, error), this E.164 number gets a one-line text.
# Leave empty to disable. Optional hourly cap guards the staff phone.
STAFF_ALERT_PHONE=""
STAFF_ALERT_HOURLY_CAP="12"

# Staff document vault + policy library (Supabase Storage).
#
# These features write to a PRIVATE Storage bucket named exactly `staff-docs`.
# A migration CANNOT create a Storage bucket, so it is created once, by hand, in the
# Supabase dashboard: Storage -> New bucket -> name `staff-docs`, PUBLIC OFF.
#
# This is recorded here on purpose. The `onboarding` bucket was created out of band
# with nothing written down anywhere, so a fresh environment fails at the first
# upload with an opaque "We could not store that file" and no clue why. Set this flag
# once the bucket exists and the Settings integration panel will show it as done.
# It is a RECORDED SETTING, not a live check of the bucket.
STAFF_DOCS_BUCKET_READY=
